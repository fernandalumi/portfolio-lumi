---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import MetaItem from '../components/MetaItem.astro';
import FilterChip from '../components/FilterChip.astro';
import Button from '../components/Button.astro';
import { site } from '../data/site';
import flowerHero from '../assets/brand/flower-hero.png';

const channels = [
  { label: 'E-mail', value: site.email, href: `mailto:${site.email}` },
  { label: 'LinkedIn', value: 'in/fernandalumist', href: site.linkedin, external: true },
  { label: 'Behance', value: 'behance.net/fernandalumist', href: site.behance, external: true },
  { label: 'Currículo', value: 'Baixar PDF', href: site.cv },
];
const subjects = ['Oportunidade de trabalho', 'Projeto freelance', 'Design system', 'Outro assunto'];
---

<Base title="Contato" description="Fale com Fernanda Lumi Sato: oportunidades em times de produto, projetos freelance e parcerias.">
  <section class="hero">
    <Image src={flowerHero} alt="" class="hero__flower flower" widths={[400, 814]} sizes="(min-width: 900px) 700px, 300px" loading="eager" />
    <div class="container hero__inner">
      <p class="t-eyebrow c-tertiary">Contato</p>
      <h1 class="t-display hero__title">Vamos conversar sobre o seu próximo projeto?</h1>
      <p class="t-body-lg c-secondary hero__lead">Estou aberta a oportunidades em times de produto, projetos freelance e parcerias. Me conte o contexto, o desafio e o prazo, e eu respondo por e-mail.</p>
      <p class="status t-body-sm"><span class="status__dot" aria-hidden="true"></span>Disponível para novos projetos</p>
    </div>
  </section>

  <section class="container main">
    <div class="channels">
      <ul class="channels__list">
        {channels.map((c) => (
          <li>
            <a href={c.href} class="channel" {...(c.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}>
              <span class="channel__text">
                <span class="t-eyebrow c-tertiary">{c.label}</span>
                <span class="t-h4">{c.value}</span>
              </span>
              <span class="t-h3 channel__arrow" aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ul>
      <dl class="channels__info">
        <MetaItem label="Base" value="São Paulo, Brasil (GMT-3)" />
        <MetaItem label="Idiomas" value="Português e inglês" />
      </dl>
    </div>

    <form class="form" id="contact-form" action={site.formEndpoint || undefined} method="post" data-email={site.email}>
      <div class="form__head">
        <h2 class="t-h3">Envie uma mensagem</h2>
        <p class="t-body c-secondary">Todos os campos são obrigatórios, exceto empresa.</p>
      </div>

      <div class="form__row">
        <div class="field">
          <label for="nome" class="t-label c-secondary">Nome</label>
          <input id="nome" name="nome" type="text" autocomplete="name" required placeholder="Como posso te chamar?" />
        </div>
        <div class="field">
          <label for="email" class="t-label c-secondary">E-mail</label>
          <input id="email" name="email" type="email" autocomplete="email" required placeholder="voce@empresa.com" />
        </div>
      </div>

      <div class="field">
        <label for="empresa" class="t-label c-secondary">Empresa (opcional)</label>
        <input id="empresa" name="empresa" type="text" autocomplete="organization" placeholder="Onde você trabalha ou nome do projeto" />
      </div>

      <fieldset class="field">
        <legend class="t-label c-secondary">Assunto</legend>
        <div class="chips">
          {subjects.map((s, i) => <FilterChip name="assunto" value={s} checked={i === 0}>{s}</FilterChip>)}
        </div>
      </fieldset>

      <div class="field">
        <label for="mensagem" class="t-label c-secondary">Mensagem</label>
        <textarea id="mensagem" name="mensagem" rows="6" required placeholder="Conte o contexto, o desafio e o prazo do projeto"></textarea>
      </div>

      <div class="form__actions">
        <Button type="submit">Enviar mensagem →</Button>
        <p class="t-body-sm c-secondary">Prefere e-mail direto? Escreva para <a href={`mailto:${site.email}`} class="inline-link">{site.email}</a></p>
      </div>
      <p class="form__status t-body c-secondary" role="status" aria-live="polite"></p>
      <!-- Campo invisível contra spam: pessoas não veem nem preenchem, robôs sim -->
      <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px;width:1px;height:1px;opacity:0" />
    </form>
  </section>
</Base>

<script>
  // Sem serviço de formulário configurado, monta o e-mail e abre o app de e-mail da pessoa.
  // Com serviço configurado (site.formEndpoint), envia a mensagem por lá.
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const data = new FormData(form);
    const status = form.querySelector<HTMLElement>('.form__status');
    const endpoint = form.getAttribute('action');
    if (!endpoint) {
      const subject = `${data.get('assunto')} · ${data.get('nome')}`;
      const body = `${data.get('mensagem')}\n\n${data.get('nome')}\n${data.get('email')}${data.get('empresa') ? '\n' + data.get('empresa') : ''}`;
      window.location.href = `mailto:${form.dataset.email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
      return;
    }
    // Assunto do e-mail que chega na caixa de entrada (campo especial do Formspree)
    data.set('_subject', `Portfólio · ${data.get('assunto')} · ${data.get('nome')}`);
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    if (button) button.disabled = true;
    if (status) status.textContent = 'Enviando…';
    try {
      const res = await fetch(endpoint, { method: 'POST', body: data, headers: { Accept: 'application/json' } });
      if (!res.ok) {
        const json = await res.json().catch(() => null);
        const msg = json?.errors?.map((e: { message: string }) => e.message).join(' ');
        throw new Error(msg || '');
      }
      form.reset();
      if (status) status.textContent = 'Mensagem enviada. Obrigada! Respondo por e-mail.';
    } catch (err) {
      const detail = err instanceof Error && err.message ? ` (${err.message})` : '';
      if (status) status.textContent = `Não foi possível enviar agora${detail}. Escreva para ${form.dataset.email}.`;
    } finally {
      if (button) button.disabled = false;
    }
  });
</script>

<style>
  .hero {
    position: relative;
    overflow: hidden;
  }
  .hero__flower {
    position: absolute;
    width: 300px;
    height: auto;
    right: -80px;
    top: -60px;
    opacity: 0.55;
  }
  .hero__inner {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-24);
    padding-top: var(--space-48);
    padding-bottom: var(--space-48);
  }
  .hero__title { max-width: 820px; }
  .hero__lead { max-width: 640px; }
  .status {
    display: inline-flex;
    align-items: center;
    gap: var(--space-8);
    padding: var(--space-8) var(--space-16) var(--space-8) 14px;
    background: var(--bg-default);
    border: var(--border-width) solid var(--border-default);
    border-radius: var(--radius-full);
  }
  .status__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent-green);
  }

  .main {
    display: flex;
    flex-direction: column;
    gap: var(--space-48);
    padding-top: var(--space-24);
    padding-bottom: var(--layout-section);
  }
  .channels {
    display: flex;
    flex-direction: column;
    gap: var(--space-32);
  }
  .channel {
    display: flex;
    align-items: center;
    gap: var(--space-16);
    padding-block: var(--space-24);
    border-top: var(--border-width) solid var(--border-default);
  }
  .channel__text {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    flex: 1;
    min-width: 0;
    overflow-wrap: anywhere;
  }
  .channel__arrow {
    transition: transform 250ms var(--ease-out);
  }
  .channel:hover .channel__arrow {
    transform: translateX(4px);
  }
  .channel:hover .t-h4 {
    color: var(--text-hover);
  }
  .channels__info {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-24);
    margin: 0;
    padding-top: var(--space-24);
    border-top: var(--border-width) solid var(--border-default);
  }

  .form {
    display: flex;
    flex-direction: column;
    gap: var(--space-24);
    padding: var(--space-24);
    background: var(--bg-subtle);
    border-radius: var(--radius-16);
  }
  .form__head {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }
  .form__row {
    display: flex;
    flex-direction: column;
    gap: var(--space-24);
  }
  .field {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
    flex: 1;
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }
  fieldset.field legend {
    padding: 0;
    margin-bottom: var(--space-12);
  }
  .field input,
  .field textarea {
    width: 100%;
    min-height: 48px;
    padding: 12px var(--space-16);
    font: inherit;
    font-size: var(--fs-body);
    line-height: 1.65;
    color: var(--text-primary);
    background: var(--bg-default);
    border: var(--border-width) solid var(--border-default);
    border-radius: var(--radius-8);
    transition: border-color 200ms var(--ease-out);
  }
  .field textarea {
    min-height: 160px;
    resize: vertical;
  }
  .field input::placeholder,
  .field textarea::placeholder {
    color: var(--text-muted);
  }
  .field input:hover,
  .field textarea:hover {
    border-color: var(--text-muted);
  }
  .field input:focus,
  .field textarea:focus {
    outline: none;
    border-color: var(--border-strong);
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-8);
  }
  .form__actions {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-16);
  }
  .inline-link {
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .form__status:empty {
    display: none;
  }

  @media (min-width: 900px) {
    .hero__flower {
      width: 700px;
      right: auto;
      left: calc(50% + 200px);
      top: -140px;
      opacity: 1;
    }
    .hero__inner {
      gap: var(--space-32);
      padding-block: var(--space-96);
    }
    .main {
      display: grid;
      grid-template-columns: 480px minmax(0, 1fr);
      gap: var(--space-96);
      align-items: start;
      padding-top: var(--space-48);
      padding-bottom: var(--space-48);
    }
    .form {
      padding: var(--space-48);
    }
    .form__row {
      flex-direction: row;
    }
    .form__actions {
      flex-direction: row;
      align-items: center;
      gap: var(--space-24);
    }
  }
</style>
