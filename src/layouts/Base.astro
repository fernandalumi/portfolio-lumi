---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import SmoothScroll from '../components/SmoothScroll.astro';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  /** Keeps the page on the light theme and hides the switch (case pages use fixed Figma colors) */
  lockLight?: boolean;
  /** Lets the page start under a transparent menu (Home hero) */
  navOverlay?: boolean;
}
const { title, description = site.description, lockLight = false, navOverlay = false } = Astro.props;
const pageTitle = title ? `${title} · ${site.name}` : `${site.name} · ${site.role}`;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
---

<!doctype html>
<html lang="pt-BR" data-theme="light" data-theme-lock={lockLight ? '' : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" href="/favicon.png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="pt_BR" />
    <meta name="theme-color" content="#f3f2f0" />
    <script is:inline>
      // Runs before the first paint: saved choice first, then the system setting
      (function () {
        var root = document.documentElement;
        if (root.hasAttribute('data-theme-lock')) return;
        var saved = null;
        try { saved = localStorage.getItem('tema'); } catch (e) {}
        var theme = saved === 'dark' || saved === 'light' ? saved : matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        root.setAttribute('data-theme', theme);
        document.querySelector('meta[name=theme-color]').content = theme === 'dark' ? '#0a0a0a' : '#f3f2f0';
      })();
    </script>
  </head>
  <body>
    <a href="#conteudo" class="skip-link">Pular para o conteúdo</a>
    <Nav themeSwitch={!lockLight} overlay={navOverlay} />
    <main id="conteudo">
      <slot />
    </main>
    <Footer />
    <SmoothScroll />
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    left: var(--layout-margin);
    top: -100px;
    z-index: 100;
    padding: var(--space-8) var(--space-16);
    background: var(--bg-inverse);
    color: var(--text-inverse);
    border-radius: var(--radius-8);
  }
  .skip-link:focus {
    top: var(--space-8);
  }
</style>
