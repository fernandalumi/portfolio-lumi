---
// Figma: component "Footer" (Breakpoint=Desktop / Breakpoint=Mobile)
import { Image } from 'astro:assets';
import { footer } from '../data/site';
import TextLink from './TextLink.astro';
import flower from '../assets/brand/flower-coral.png';
---

<footer class="footer">
  <div class="container footer__inner">
    <div class="footer__top">
      <div class="footer__cta">
        <div class="footer__title">
          <h2 class="t-h1 footer__heading">{footer.title}</h2>
          <Image src={flower} alt="" width={64} height={64} class="flower" />
        </div>
        <p class="t-body c-tertiary">{footer.text}</p>
      </div>

      <div class="footer__links">
        <nav aria-label="Navegação do rodapé">
          <p class="t-body c-tertiary">Navegação</p>
          <ul>{footer.navigation.map((l) => <li><TextLink href={l.href}>{l.label}</TextLink></li>)}</ul>
        </nav>
        <div>
          <p class="t-body c-tertiary">Contato</p>
          <ul>{footer.contact.map((l) => <li><TextLink href={l.href} external={l.href.startsWith('http')}>{l.label}</TextLink></li>)}</ul>
        </div>
      </div>
    </div>

    <div class="footer__bottom">
      <p class="t-body-sm c-tertiary">{footer.copyright}</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: radial-gradient(60% 70% at 72% 120%, var(--glow), transparent 100%);
  }
  .footer__inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-64);
    padding-top: var(--space-64);
    padding-bottom: var(--space-32);
  }
  .footer__top {
    display: flex;
    flex-direction: column;
    gap: var(--space-48);
  }
  .footer__cta {
    display: flex;
    flex-direction: column;
    gap: var(--space-16);
  }
  .footer__cta p {
    max-width: 360px;
  }
  .footer__title {
    display: flex;
    white-space: nowrap;
    align-items: center;
    gap: var(--space-16);
  }
  .footer__title .footer__heading {
    font-size: clamp(44px, 7vw, 96px);
  }
  .footer__title :global(img) {
    width: 64px;
    height: 64px;
  }
  .footer__links {
    display: flex;
    gap: var(--space-96);
  }
  .footer__links ul {
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
    margin-top: var(--space-12);
  }
  .footer__bottom {
    padding-top: var(--space-24);
    border-top: var(--border-width) solid var(--border-default);
  }

  @media (min-width: 900px) {
    .footer__inner {
      gap: var(--space-120);
      padding-top: var(--space-96);
    }
    .footer__top {
      flex-direction: row;
      justify-content: space-between;
    }
  }
</style>
