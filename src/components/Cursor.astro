---
// Custom cursor: a dot in a deeper version of the design-system accent pink that follows the mouse.
// Over a case link it grows into the tag "Visualizar case →"; over other links and
// buttons it grows a little. Only on devices with a mouse (touch screens keep the
// native behaviour), and text fields keep the native text cursor.
---

<div class="cursor" aria-hidden="true">
  <span class="cursor__label t-label">Visualizar case <span class="cursor__arrow">→</span></span>
</div>

<script>
  const cursor = document.querySelector<HTMLElement>('.cursor');
  const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');

  if (cursor && finePointer.matches) {
    document.documentElement.classList.add('has-custom-cursor');
    let x = -100, y = -100, cx = -100, cy = -100, frame = 0;

    const render = () => {
      // Light trailing so the dot feels soft; immediate when motion is reduced
      const k = reduce.matches ? 1 : 0.35;
      cx += (x - cx) * k;
      cy += (y - cy) * k;
      cursor.style.transform = `translate3d(${cx}px, ${cy}px, 0)`;
      frame = Math.abs(x - cx) + Math.abs(y - cy) > 0.1 ? requestAnimationFrame(render) : 0;
    };

    const CASE = 'a[href^="/projetos/"]';
    const INTERACTIVE = 'a, button, label, select, summary, [role="button"]';
    const TEXT = 'input:not([type="radio"]):not([type="checkbox"]), textarea';

    document.addEventListener('pointermove', (e) => {
      if (e.pointerType !== 'mouse') return;
      x = e.clientX;
      y = e.clientY;
      const target = e.target as Element;
      cursor.classList.add('is-visible');
      cursor.classList.toggle('is-case', !!target.closest(CASE));
      cursor.classList.toggle('is-link', !target.closest(CASE) && !!target.closest(INTERACTIVE));
      cursor.classList.toggle('is-text', !!target.closest(TEXT));
      if (!frame) frame = requestAnimationFrame(render);
    }, { passive: true });

    document.addEventListener('pointerdown', () => cursor.classList.add('is-pressed'));
    document.addEventListener('pointerup', () => cursor.classList.remove('is-pressed'));
    document.documentElement.addEventListener('mouseleave', () => cursor.classList.remove('is-visible'));
    document.documentElement.addEventListener('mouseenter', () => cursor.classList.add('is-visible'));
  }
</script>

<style is:global>
  /* Hide the native arrow only where the custom cursor is active */
  html.has-custom-cursor,
  html.has-custom-cursor * {
    cursor: none !important;
  }
  html.has-custom-cursor input:not([type='radio']):not([type='checkbox']),
  html.has-custom-cursor textarea {
    cursor: text !important;
  }
</style>

<style>
  .cursor {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 9999;
    pointer-events: none;
    opacity: 0;
    transition: opacity 200ms var(--ease-out);
  }
  .cursor.is-visible { opacity: 1; }
  .cursor.is-text { opacity: 0; }

  /* The dot and the tag are the same element, morphing in size and shape */
  .cursor__label {
    position: absolute;
    left: 0;
    top: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 14px;
    height: 14px;
    border-radius: var(--radius-full);
    gap: 8px;
    background: var(--pink-600);
    color: transparent;
    white-space: nowrap;
    overflow: hidden;
    transform: translate(-50%, -50%);
    transition:
      width 350ms var(--ease-out),
      height 350ms var(--ease-out),
      padding 350ms var(--ease-out),
      color 200ms var(--ease-out),
      transform 200ms var(--ease-out);
  }
  .cursor.is-link .cursor__label {
    transform: translate(-50%, -50%) scale(1.8);
  }
  .cursor.is-case .cursor__label {
    width: 188px;
    height: 40px;
    color: var(--text-inverse);
    transition-delay: 0ms, 0ms, 0ms, 120ms, 0ms;
  }
  .cursor__arrow {
    font-size: 18px;
    line-height: 1;
    letter-spacing: 0;
    transform: translateY(-1px);
  }
  .cursor.is-pressed .cursor__label {
    transform: translate(-50%, -50%) scale(0.85);
  }
</style>
