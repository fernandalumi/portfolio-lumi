---
// Before and after comparison: drag the handle (or use the arrow keys) to reveal one screenshot over the other.
interface Props { before: string; after: string; label: string; mobile?: boolean }
const { before, after, label, mobile = false } = Astro.props;
---

<div class:list={['cmp', { 'cmp--m': mobile }]} data-compare>
  <div class="cmp-frame">
    <img src={after} alt={`${label} depois do redesign`} loading="lazy" decoding="async" />
    <div class="cmp-before"><img src={before} alt={`${label} antes, no site atual`} loading="lazy" decoding="async" /></div>
    <span class="cmp-tag cmp-tag--a"><i></i>Antes</span>
    <span class="cmp-tag cmp-tag--d"><i></i>Depois</span>
    <div class="cmp-line" aria-hidden="true"><span>‹ ›</span></div>
    <input type="range" min="0" max="100" value="50" aria-label={`Comparar ${label} antes e depois`} />
  </div>
</div>

<script>
  for (const el of document.querySelectorAll<HTMLElement>('[data-compare]')) {
    const r = el.querySelector('input')!;
    const set = () => el.style.setProperty('--p', r.value + '%');
    r.addEventListener('input', set); set();
  }
</script>

<style>
  .cmp { --p: 50%; align-self: stretch; background: #f2f2f3; border-radius: 32px; padding: 40px; }
  .cmp--m { border-radius: 20px; padding: 16px; }
  .cmp-frame { position: relative; border-radius: 12px; overflow: hidden; box-shadow: 0 24px 64px rgba(0,0,0,.14), 0 2px 6px rgba(0,0,0,.1); background: #fff; }
  .cmp--m .cmp-frame { max-width: 320px; margin: 0 auto; border-radius: 24px; }
  .cmp-frame img { display: block; width: 100%; height: auto; }
  .cmp-before { position: absolute; inset: 0; clip-path: inset(0 calc(100% - var(--p)) 0 0); }
  .cmp-before img { width: 100%; height: 100%; object-fit: cover; object-position: top; }
  .cmp-line { position: absolute; top: 0; bottom: 0; left: var(--p); width: 2px; margin-left: -1px; background: #fff; box-shadow: 0 0 0 1px rgba(0,0,0,.12); pointer-events: none; }
  .cmp-line span { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); width: 40px; height: 40px; border-radius: 50%; background: #fff; display: grid; place-items: center; font: 600 14px var(--font-text); color: #202224; box-shadow: 0 2px 8px rgba(0,0,0,.2); }
  .cmp input { position: absolute; inset: 0; width: 100%; height: 100%; opacity: 0; cursor: ew-resize; margin: 0; }
  .cmp input:focus-visible + .cmp-line, .cmp-frame:has(input:focus-visible) .cmp-line span { outline: 2px solid #202224; outline-offset: 2px; }
  .cmp-tag { position: absolute; top: 12px; display: inline-flex; align-items: center; gap: 8px; background: #fff; border-radius: 2px; padding: 5px 10px; font: 500 13px/1.3 var(--font-text); color: #202224; pointer-events: none; }
  .cmp-tag i { width: 8px; height: 8px; border-radius: 50%; }
  .cmp-tag--a { left: 12px; } .cmp-tag--a i { background: #9ea0a8; }
  .cmp-tag--d { right: 12px; } .cmp-tag--d i { background: #00a3c4; }
</style>
