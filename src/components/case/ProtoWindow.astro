---
// Live prototype inside a Safari style window, used by cases that ship a navigable prototype in /public/prototipos.
// Desktop: the site renders at 1440 px and is scaled down to fit; tabs switch pages; the toggle swaps to a phone.
// Mobile: a preview image with a button that opens the prototype full screen (scrolling inside a frame is poor on touch).
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Page { label: string; path: string }
interface Props { base: string; pages: Page[]; poster?: ImageMetadata; mobile?: boolean; W: number; H: number }
const { base, pages, poster, mobile = false, W, H } = Astro.props;
const first = base + pages[0].path;
---

{mobile ? (
  <div class="pw-m" style={`aspect-ratio:${W} / ${H}`}>
    {poster && <Image src={poster} alt="Prévia do protótipo navegável da Catharine Hill" widths={[390, 780, 1170]} sizes="100vw" />}
    <a class="pw-open" href={first} target="_blank" rel="noopener">Navegar no protótipo</a>
  </div>
) : (
  <div class="pw" data-proto data-base={base}>
    <div class="pw-ctl">
      <div class="pw-tabs" role="tablist" aria-label="Páginas do protótipo">
        {pages.map((p, i) => <button type="button" role="tab" aria-selected={i === 0 ? 'true' : 'false'} data-path={p.path}>{p.label}</button>)}
      </div>
      <div class="pw-dev" role="group" aria-label="Tamanho de tela">
        <button type="button" aria-pressed="true" data-dev="d" aria-label="Desktop">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="12" rx="1.5"/><path d="M8 20h8M12 16v4"/></svg>
        </button>
        <button type="button" aria-pressed="false" data-dev="m" aria-label="Mobile">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="7" y="2.5" width="10" height="19" rx="2"/><path d="M11 18.5h2"/></svg>
        </button>
      </div>
    </div>
    <div class="pw-safari">
      <div class="pw-bar"><span class="pw-dots"><i></i><i></i><i></i></span><span class="pw-url">catharinehill.com.br</span><a class="pw-full" href={first} target="_blank" rel="noopener">Abrir em tela cheia</a></div>
      <div class="pw-view"><iframe title="Protótipo navegável, desktop" data-src={first} loading="lazy"></iframe></div>
    </div>
    <div class="pw-phone" hidden><iframe title="Protótipo navegável, mobile" loading="lazy"></iframe></div>
    <p class="pw-hint">Role dentro da janela, troque de página nas abas e alterne para o mobile.</p>
  </div>
)}

<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-proto]')) {
    const base = root.dataset.base!;
    const view = root.querySelector<HTMLElement>('.pw-view')!;
    const fd = view.querySelector('iframe')!;
    const phone = root.querySelector<HTMLElement>('.pw-phone')!;
    const fm = phone.querySelector('iframe')!;
    const safari = root.querySelector<HTMLElement>('.pw-safari')!;
    const full = root.querySelector<HTMLAnchorElement>('.pw-full')!;
    const url = root.querySelector<HTMLElement>('.pw-url')!;
    let path = root.querySelector<HTMLElement>('[data-path]')!.dataset.path!;
    let dev = 'd';
    const fit = () => { const s = view.clientWidth / 1440; fd.style.transform = `scale(${s})`; fd.style.height = `${view.clientHeight / s}px`; };
    const load = () => {
      const src = base + path;
      const f = dev === 'd' ? fd : fm;
      if (f.getAttribute('src') !== src) f.src = src;
      full.href = src;
      url.textContent = 'catharinehill.com.br' + (path.includes('internas/') ? '/' + path.split('/').pop()!.replace('.html', '') : '');
    };
    // carrega só quando a janela aparece na tela
    new IntersectionObserver((e, o) => { if (e[0].isIntersecting) { load(); fit(); o.disconnect(); } }, { rootMargin: '200px' }).observe(root);
    root.querySelectorAll<HTMLButtonElement>('[data-path]').forEach((b) => b.addEventListener('click', () => {
      root.querySelectorAll('[data-path]').forEach((x) => x.setAttribute('aria-selected', String(x === b)));
      path = b.dataset.path!; load();
    }));
    root.querySelectorAll<HTMLButtonElement>('[data-dev]').forEach((b) => b.addEventListener('click', () => {
      root.querySelectorAll('[data-dev]').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      dev = b.dataset.dev!; safari.hidden = dev === 'm'; phone.hidden = dev === 'd'; load(); fit();
    }));
    addEventListener('resize', fit);
  }
</script>

<style>
  .pw { align-self: stretch; background: #f2f2f3; border-radius: 32px; padding: 40px 48px 32px; display: flex; flex-direction: column; gap: 24px; }
  .pw-ctl { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; }
  .pw-tabs { grid-column: 2; display: flex; gap: 4px; background: #fff; border-radius: 999px; padding: 4px; }
  .pw-dev { grid-column: 3; justify-self: end; display: flex; gap: 4px; background: #fff; border-radius: 999px; padding: 4px; }
  .pw button { border: 0; background: none; border-radius: 999px; padding: 8px 16px; font: 500 14px/1.4 var(--font-text); color: #5c5f66; cursor: pointer; display: flex; align-items: center; }
  .pw-dev button { padding: 8px 12px; }
  .pw button[aria-selected='true'], .pw button[aria-pressed='true'] { background: #202224; color: #fff; }
  .pw button:focus-visible { outline: 2px solid #202224; outline-offset: 2px; }
  .pw-safari { background: #fff; border-radius: 14px; overflow: hidden; box-shadow: 0 24px 64px rgba(0,0,0,.14), 0 2px 6px rgba(0,0,0,.1); }
  .pw-bar { height: 36px; background: #f3f4f6; display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; padding: 0 14px; }
  .pw-dots { display: flex; gap: 6px; } .pw-dots i { width: 10px; height: 10px; border-radius: 50%; background: #ff5f57; } .pw-dots i:nth-child(2) { background: #febc2e; } .pw-dots i:nth-child(3) { background: #28c840; }
  .pw-url { font: 12px var(--font-text); color: #5c5f66; background: #e5e6ea; border-radius: 6px; padding: 4px 16px; }
  .pw-full { justify-self: end; font: 500 12px var(--font-text); color: #202224; text-decoration: underline; text-underline-offset: 3px; }
  .pw-view { position: relative; height: min(70vh, 640px); overflow: hidden; }
  .pw-view iframe { position: absolute; left: 0; top: 0; width: 1440px; border: 0; transform-origin: 0 0; }
  .pw-phone { align-self: center; width: 390px; height: min(78vh, 780px); border-radius: 48px; padding: 12px; background: #1a1a1a; box-shadow: 0 24px 64px rgba(0,0,0,.18); }
  .pw-phone iframe { width: 100%; height: 100%; border: 0; border-radius: 36px; background: #fff; }
  .pw-hint { margin: 0; font: 14px/1.5 var(--font-text); color: #6b6d76; text-align: center; }
  .pw-m { position: relative; align-self: stretch; border-radius: 20px; overflow: hidden; background: #f2f2f3; }
  .pw-m :global(img) { width: 100%; height: 100%; object-fit: cover; display: block; }
  .pw-open { position: absolute; left: 50%; bottom: 16px; transform: translateX(-50%); background: #202224; color: #fff; border-radius: 999px; padding: 10px 18px; font: 500 14px var(--font-text); white-space: nowrap; }
</style>
