---
// Figma: component "Alternar tema" (Tema=Escuro / Tema=Claro). The theme starts from the
// system setting (see Base.astro) and keeps the visitor's choice after the first click.
---

<button class="theme" type="button" role="switch" aria-checked="false" aria-label="Tema escuro">
  <span class="theme__knob">
    <svg class="theme__moon" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M13.5 9.6A5.8 5.8 0 1 1 6.4 2.5a4.6 4.6 0 0 0 7.1 7.1Z" fill="currentColor" /></svg>
    <svg class="theme__sun" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><circle cx="8" cy="8" r="3" fill="currentColor" /><path d="M8 1.2v1.6M8 13.2v1.6M1.2 8h1.6M13.2 8h1.6M3.2 3.2l1.1 1.1M11.7 11.7l1.1 1.1M3.2 12.8l1.1-1.1M11.7 4.3l1.1-1.1" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" /></svg>
  </span>
</button>

<script>
  const root = document.documentElement;
  const meta = document.querySelector<HTMLMetaElement>('meta[name=theme-color]');
  const system = window.matchMedia('(prefers-color-scheme: dark)');
  const buttons = document.querySelectorAll<HTMLButtonElement>('.theme');

  const apply = (theme: string) => {
    root.dataset.theme = theme;
    if (meta) meta.content = theme === 'dark' ? '#0a0a0a' : '#f3f2f0';
    buttons.forEach((b) => b.setAttribute('aria-checked', String(theme === 'dark')));
  };
  const saved = () => {
    try { return localStorage.getItem('tema'); } catch { return null; }
  };

  apply(root.dataset.theme ?? 'light');
  buttons.forEach((b) =>
    b.addEventListener('click', () => {
      const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
      apply(next);
      try { localStorage.setItem('tema', next); } catch { /* private mode: the choice lasts for this page only */ }
    }),
  );
  // Follows the system while the visitor has not chosen a theme
  system.addEventListener('change', (e) => { if (!saved()) apply(e.matches ? 'dark' : 'light'); });
</script>

<style>
  .theme {
    position: relative;
    flex-shrink: 0;
    width: 60px;
    height: 32px;
    padding: 0;
    border: var(--border-width) solid color-mix(in srgb, var(--text-primary) 25%, transparent);
    border-radius: var(--radius-full);
    background: color-mix(in srgb, var(--text-primary) 8%, transparent);
    cursor: pointer;
  }
  .theme__knob {
    position: absolute;
    top: 3px;
    left: 3px;
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: var(--text-primary);
    color: var(--text-inverse);
    transition: transform 300ms var(--ease-out);
  }
  .theme[aria-checked='false'] .theme__knob {
    transform: translateX(28px);
  }
  .theme__moon, .theme__sun {
    grid-area: 1 / 1;
  }
  .theme[aria-checked='true'] .theme__sun,
  .theme[aria-checked='false'] .theme__moon {
    display: none;
  }
</style>
