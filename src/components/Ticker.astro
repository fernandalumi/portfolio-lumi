---
// Figma: component "Ticker row" (Default / Variant2). Two rows moving in opposite
// directions, about 40s per loop, paused when the visitor prefers reduced motion.
// Images come from the component (exported at 4x into src/assets/brand/ticker/).
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import t1Flower1 from '../assets/brand/ticker/t1-01-flower.webp';
import t1Bar1 from '../assets/brand/ticker/t1-02-bar.webp';
import t1Flower2 from '../assets/brand/ticker/t1-03-flower.webp';
import t1Bar2 from '../assets/brand/ticker/t1-04-bar.webp';
import t2Flower1 from '../assets/brand/ticker/t2-05-flower.webp';
import t2Bar1 from '../assets/brand/ticker/t2-06-bar.webp';
import t2Flower2 from '../assets/brand/ticker/t2-07-flower.webp';
import t2Bar2 from '../assets/brand/ticker/t2-08-bar.webp';
import t2Bar3 from '../assets/brand/ticker/t2-09-bar.webp';

type Item = { word: string } | { flower: ImageMetadata } | { bar: ImageMetadata };
const rows: Item[][] = [
  [{ word: 'Intenção' }, { flower: t1Flower1 }, { word: 'Perspectiva' }, { bar: t1Bar1 }, { word: 'Curiosidade' }, { flower: t1Flower2 }, { word: 'Propósito' }, { bar: t1Bar2 }],
  [{ flower: t2Flower1 }, { word: 'Experiência' }, { bar: t2Bar1 }, { word: 'Solução' }, { flower: t2Flower2 }, { word: 'Impacto' }, { bar: t2Bar2 }, { word: 'Função' }, { bar: t2Bar3 }],
];
---

<section class="ticker" aria-label="Intenção, perspectiva, curiosidade, propósito, experiência, solução, impacto, função">
  {rows.map((items, i) => (
    <div class:list={['ticker__row', i % 2 ? 'is-reverse' : 'is-first']} aria-hidden="true">
      {[0, 1].map(() => (
        <div class="ticker__track">
          {items.map((it) =>
            'word' in it ? <span class="t-ticker">{it.word}</span>
            : 'flower' in it ? <Image src={it.flower} alt="" widths={[56, 112, 168, 224]} sizes="56px" class="ticker__flower flower" />
            : <Image src={it.bar} alt="" widths={[110, 220, 330, 440]} sizes="110px" class="ticker__bar" />
          )}
        </div>
      ))}
    </div>
  ))}
</section>

<style>
  /* Figma: rows touch each other (no gap), 24px above and below the words,
     a line on top of the first row and under every row, 80px after the block */
  .ticker {
    display: flex;
    flex-direction: column;
    padding-bottom: var(--space-80);
    overflow: hidden;
  }
  .ticker__row {
    display: flex;
    width: max-content;
    border-bottom: var(--border-width) solid var(--border-default);
    animation: ticker 40s linear infinite;
  }
  .ticker__row.is-first {
    border-top: var(--border-width) solid var(--border-default);
  }
  .ticker__row.is-reverse {
    animation-direction: reverse;
  }
  .ticker__track {
    display: flex;
    align-items: center;
    gap: var(--space-24);
    padding: var(--space-24) var(--space-24) var(--space-24) 0;
    flex-shrink: 0;
  }
  .ticker__track > * {
    flex-shrink: 0;
  }
  /* Images keep the Figma proportion to the word size (56px next to 72px text) */
  .ticker__flower {
    width: calc(var(--fs-ticker) * 0.78);
    height: calc(var(--fs-ticker) * 0.78);
    border-radius: 50%;
  }
  .ticker__bar {
    width: calc(var(--fs-ticker) * 1.53);
    height: calc(var(--fs-ticker) * 0.78);
    border-radius: var(--radius-4);
    object-fit: cover;
  }
  @keyframes ticker {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }
  @media (prefers-reduced-motion: reduce) {
    .ticker__row { animation: none; }
  }
</style>
