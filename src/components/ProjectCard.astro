---
// Figma: component "Project card" (State=Default / Hover)
import { Image } from 'astro:assets';
import Tag from './Tag.astro';
import type { Project } from '../data/projects';

interface Props {
  project: Project;
  eager?: boolean;
}
const { project, eager = false } = Astro.props;
---

<article class="card" data-categories={project.categories.join('|')}>
  <a href={`/projetos/${project.slug}`} class="card__link">
    <div class="card__media">
      <Image
        src={project.image}
        alt={project.imageAlt}
        widths={[400, 700, 1264]}
        sizes="(min-width: 900px) 50vw, 100vw"
        loading={eager ? 'eager' : 'lazy'}
      />
    </div>
    <div class="card__info">
      <h3 class="card__title t-h3">{project.title}</h3>
      <p class="t-body c-tertiary">{project.description}</p>
    </div>
  </a>
  <ul class="card__tags" aria-label="Tags">
    {project.tags.map((t) => <li><Tag>{t}</Tag></li>)}
  </ul>
</article>

<style>
  .card {
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
  }
  .card__link {
    display: flex;
    flex-direction: column;
    gap: var(--space-24);
  }
  .card__media {
    aspect-ratio: 632 / 424;
    border-radius: var(--radius-16);
    background: var(--bg-subtle);
    overflow: hidden;
  }
  .card__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 400ms var(--ease-out);
  }
  .card__info {
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
  }
  .card__title {
    transition: color 200ms var(--ease-out);
  }
  .card__link:hover .card__media :global(img) {
    transform: scale(1.05);
  }
  .card__link:hover .card__title {
    color: var(--text-hover);
  }
  .card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-8);
  }
</style>
