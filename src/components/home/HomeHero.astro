---
// Hero: title spread across the page over a mist drawn in the browser, with the blurred flower
// and its connectors above it. On desktop each point opens a focus panel over the blurred hero.
import { Image } from 'astro:assets';
import { hero } from '../../data/home';
import { caseImages } from '../figma/images';

const petals = Array.from({ length: 8 }, (_, i) => i * 45);
const path = (p: (typeof hero.points)[number]) => {
  const left = p.tagX + 40 < p.x;
  const edge = left ? p.tagX + 90 : p.tagX + 60;
  const y = p.tagY + (p.tagY < p.y ? 34 : 0);
  return `M${p.x} ${p.y} H${edge + (left ? 14 : -14)} Q${edge} ${p.y} ${edge} ${p.y + (y > p.y ? 14 : -14)} V${y}`;
};
---

<section class="hero" data-hero>
  <svg class="hero__fog" aria-hidden="true">
    <filter id="hero-nevoa" x="0" y="0" width="100%" height="100%">
      <feTurbulence type="fractalNoise" baseFrequency="0.0026 0.0048" numOctaves="5" seed="11" />
      <feColorMatrix values="0 0 0 0 0.62  0 0 0 0 0.69  0 0 0 0 0.76  1.9 0 0 0 -0.72" />
    </filter>
    <rect width="100%" height="100%" filter="url(#hero-nevoa)" />
  </svg>
  <div class="hero__stage">
    <div class="hero__flower" aria-hidden="true">
      <div class="hero__petals">{petals.map((a) => <i style={`--a:${a}deg`}></i>)}</div>
    </div>
    <svg class="hero__lines" viewBox="0 0 860 620" fill="none" aria-hidden="true">
      {hero.points.map((p) => <path d={path(p)} />)}
    </svg>
    {hero.points.map((p, i) => (
      <button type="button" class="point" style={`--x:${p.x}px;--y:${p.y}px;--tx:${p.tagX}px;--ty:${p.tagY}px`} data-point={i} aria-expanded="false">
        <span class="point__dot"></span>
        <span class="point__tag">{p.label}</span>
      </button>
    ))}
  </div>

  <div class="container hero__inner">
    <p class="t-body-lg c-secondary hero__text">{hero.text}</p>
    <h1 class="headline">
      <span class="headline__intro">{hero.greeting}<br />{hero.titleIntro}</span>{' '}
      <span class="headline__line"><span>{hero.titleA}</span> <span>{hero.titleB}</span></span>{' '}
      <span class="headline__line headline__line--b"><span>{hero.titleC}</span> <span class="headline__accent">{hero.titleAccent}</span></span>
    </h1>
    <a href={hero.cta.href} class="hero__cta">{hero.cta.label} <i aria-hidden="true">↓</i></a>
  </div>

  <span class="star star--large" style="--sx:15%;--sy:128px;--ss:260px" aria-hidden="true"></span>
  <span class="star" style="--sx:21%;--sy:30px;--ss:110px;--sd:-3s" aria-hidden="true"></span>

  <div class="hero__veil" aria-hidden="true"></div>
  {hero.points.map((p, i) => (
    <a href={p.href} class="focus" data-focus={i} tabindex="-1">
      <span class="focus__frame">
        <Image src={caseImages[p.image]} alt="" widths={[520, 1040]} sizes="520px" class="focus__img" />
      </span>
      <span class="focus__info">
        <span class="t-h2 focus__title">{p.title}</span>
        <span class="t-body-lg c-secondary">{p.text}</span>
        <span class="t-link">Ver {p.project} →</span>
      </span>
    </a>
  ))}
</section>

<script>
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  const flower = hero?.querySelector<HTMLElement>('.hero__flower');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');

  // The flower keeps turning with the scroll, as on the previous Home
  let frame = 0;
  const tick = () => { flower?.style.setProperty('--turn', `${window.scrollY * 0.1}deg`); frame = 0; };
  if (flower && !reduce.matches) {
    window.addEventListener('scroll', () => { if (!frame) frame = requestAnimationFrame(tick); }, { passive: true });
  }

  if (hero) {
    const points = hero.querySelectorAll<HTMLButtonElement>('[data-point]');
    const panels = hero.querySelectorAll<HTMLElement>('[data-focus]');
    let timer = 0;
    const show = (i: number | null) => {
      clearTimeout(timer);
      hero.classList.toggle('is-focus', i !== null);
      panels.forEach((p, k) => { p.classList.toggle('is-open', k === i); p.tabIndex = k === i ? 0 : -1; });
      points.forEach((b, k) => b.setAttribute('aria-expanded', String(k === i)));
    };
    const later = () => { timer = window.setTimeout(() => show(null), 220); };
    points.forEach((b, i) => {
      b.addEventListener('pointerenter', () => show(i));
      b.addEventListener('pointerleave', later);
      b.addEventListener('focus', () => show(i));
      b.addEventListener('click', () => show(i));
    });
    panels.forEach((p) => {
      p.addEventListener('pointerenter', () => clearTimeout(timer));
      p.addEventListener('pointerleave', later);
      p.addEventListener('blur', later);
    });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') show(null); });
  }
</script>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    min-height: 720px;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    background:
      radial-gradient(70% 80% at 62% 30%, var(--hero-a), transparent 100%),
      radial-gradient(60% 60% at 100% 0%, var(--hero-b), transparent 100%),
      var(--bg-default);
  }
  /* Mist drawn by the browser (no image): it drifts slowly and fades before the hero ends */
  .hero__fog {
    position: absolute;
    left: -8%;
    top: -8%;
    width: 116%;
    height: 116%;
    opacity: var(--hero-fog);
    -webkit-mask-image: radial-gradient(64% 62% at 56% 42%, #000 30%, transparent 100%);
    mask-image: radial-gradient(64% 62% at 56% 42%, #000 30%, transparent 100%);
    animation: hero-fog 48s ease-in-out infinite alternate;
    will-change: transform;
  }
  /* Ends on the page color, so the hero never cuts against the next section */
  .hero::after {
    content: "";
    position: absolute;
    inset: auto 0 0;
    height: 180px;
    background: linear-gradient(transparent, var(--bg-default));
    pointer-events: none;
  }
  @keyframes hero-fog {
    from { transform: translate3d(-2%, 0, 0); }
    to { transform: translate3d(2%, -2%, 0); }
  }
  .hero__stage {
    position: absolute;
    top: 0;
    right: max(0px, calc(50% - 720px));
    width: 860px;
    height: 620px;
  }
  .hero__flower {
    position: absolute;
    left: 340px;
    top: 290px;
    width: 0;
    height: 0;
    rotate: var(--turn, 0deg);
    transition: rotate 600ms var(--ease-out);
  }
  .hero__petals {
    animation: flor 180s linear infinite;
    filter: blur(26px);
  }
  .hero__petals i {
    position: absolute;
    left: -84px;
    top: -330px;
    width: 168px;
    height: 300px;
    border-radius: 50%;
    background: var(--petal);
    transform: rotate(var(--a));
    transform-origin: 50% 330px;
  }
  @keyframes flor { to { transform: rotate(360deg); } }

  .hero__lines {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    stroke: var(--text-primary);
    stroke-opacity: 0.45;
    pointer-events: none;
    display: none;
  }
  .point {
    position: absolute;
    left: 0;
    top: 0;
    width: 0;
    height: 0;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    display: none;
  }
  .point__dot {
    position: absolute;
    left: var(--x);
    top: var(--y);
    width: 28px;
    height: 28px;
    margin: -14px 0 0 -14px;
    border-radius: 50%;
    background: radial-gradient(circle, var(--text-primary) 0 3px, transparent 3.5px);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--text-primary) 45%, transparent);
    transition: scale 300ms var(--ease-out);
  }
  .point:hover .point__dot, .point:focus-visible .point__dot { scale: 1.3; }
  .point__tag {
    position: absolute;
    left: var(--tx);
    top: var(--ty);
    padding: 6px 10px;
    border: var(--border-width) solid color-mix(in srgb, var(--text-primary) 22%, transparent);
    border-radius: var(--radius-4);
    background: color-mix(in srgb, var(--bg-default) 45%, transparent);
    backdrop-filter: blur(12px);
    color: var(--text-primary);
    font-size: 13px;
    line-height: 1.3;
    white-space: nowrap;
  }

  .hero__inner {
    position: relative;
    z-index: 1;
    padding-top: 300px;
    padding-bottom: var(--space-32);
    pointer-events: none;
  }
  .hero__inner a { pointer-events: auto; }
  .hero__text {
    max-width: 22em;
    margin-bottom: var(--space-24);
  }

  /* Title: two lines spread across the page, with the serif at the end */
  .headline {
    font-family: var(--font-heading);
    font-weight: 400;
    font-size: 13.2vw;
    line-height: 1;
    letter-spacing: -0.03em;
    text-transform: uppercase;
  }
  .headline__intro {
    display: block;
    margin-bottom: var(--space-16);
    font-size: 18px;
    font-weight: 500;
    line-height: 1.25;
    letter-spacing: -0.01em;
    text-transform: none;
  }
  .headline__line { display: block; }
  .headline__line > span { display: block; }
  .headline__accent {
    font-family: var(--font-accent);
    font-style: italic;
    font-weight: 400;
    letter-spacing: -0.01em;
  }
  .hero__cta {
    display: inline-flex;
    align-items: center;
    gap: var(--space-12);
    margin-top: var(--space-24);
    font-size: 15px;
    font-weight: 500;
    color: var(--text-primary);
  }
  .hero__cta i {
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: var(--text-primary);
    color: var(--text-inverse);
    font-style: normal;
    font-size: 14px;
    transition: translate 300ms var(--ease-out);
  }
  .hero__cta:hover i { translate: 0 3px; }

  /* Points of light: two thin rays and a soft center */
  .star {
    position: absolute;
    left: var(--sx);
    bottom: var(--sy);
    width: var(--ss);
    height: var(--ss);
    margin: calc(var(--ss) / -2);
    z-index: 1;
    pointer-events: none;
    animation: star 7s ease-in-out infinite;
    animation-delay: var(--sd, 0s);
  }
  .star::before, .star::after {
    content: "";
    position: absolute;
    inset: 0;
  }
  .star::before {
    background:
      linear-gradient(90deg, transparent, var(--text-primary) 50%, transparent) center / 100% 1px no-repeat,
      linear-gradient(transparent, var(--text-primary) 50%, transparent) center / 1px 72% no-repeat;
  }
  .star::after {
    background: radial-gradient(closest-side, var(--text-primary) 0 2%, var(--star-glow) 4%, transparent 20%);
  }
  @keyframes star {
    0%, 100% { opacity: 0.55; transform: scale(0.92); }
    50% { opacity: 1; transform: scale(1); }
  }

  .hero__veil {
    position: absolute;
    inset: 0;
    z-index: 2;
    background: color-mix(in srgb, var(--bg-default) 42%, transparent);
    backdrop-filter: blur(22px);
    opacity: 0;
    pointer-events: none;
    transition: opacity 300ms var(--ease-out);
  }
  .is-focus .hero__veil { opacity: 1; }

  .focus {
    position: absolute;
    z-index: 3;
    left: 50%;
    top: 50%;
    display: flex;
    align-items: center;
    gap: var(--space-48);
    width: min(960px, 90vw);
    transform: translate(-50%, -50%) scale(0.98);
    opacity: 0;
    visibility: hidden;
    transition: opacity 300ms var(--ease-out), transform 300ms var(--ease-out), visibility 300ms;
  }
  .focus.is-open {
    opacity: 1;
    visibility: visible;
    transform: translate(-50%, -50%);
  }
  .focus__frame {
    position: relative;
    flex: 0 0 56%;
    aspect-ratio: 13 / 10;
    outline: 1px solid color-mix(in srgb, var(--text-primary) 65%, transparent);
    outline-offset: 6px;
  }
  .focus__img { width: 100%; height: 100%; object-fit: cover; }
  .focus__info {
    display: flex;
    flex-direction: column;
    gap: var(--space-16);
  }

  @media (min-width: 900px) {
    .hero { --title: clamp(62px, 7vw, 108px); min-height: max(100vh, 720px); }
    .hero__lines, .point { display: block; }
    .hero__inner { position: relative; padding-top: 120px; }
    .hero__text { max-width: 20em; margin: 0; position: absolute; left: var(--layout-margin); bottom: calc(var(--space-32) + 2.1 * var(--title) + var(--space-24)); }
    .headline { font-size: var(--title); }
    .headline__intro { margin-bottom: var(--space-24); text-align: right; font-size: 22px; }
    .headline__line { display: flex; justify-content: space-between; }
    .headline__line--b { justify-content: flex-end; gap: 0.3em; white-space: nowrap; }
    .headline__accent { font-size: 1.1em; line-height: 0.91; }
    .hero__cta { position: absolute; left: var(--layout-margin); bottom: var(--space-40); margin: 0; }
  }
  @media (max-width: 899px) {
    .hero { min-height: 100svh; }
    .hero__stage { transform: scale(0.72); transform-origin: 100% 0; right: -170px; }
    .focus, .hero__veil { display: none; }
    .star--large { --sx: 74% !important; --sy: 38% !important; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__petals, .hero__fog, .star { animation: none; }
  }
</style>
