---
// Hero: full-bleed gradient with soft blooms, the title large at the bottom and a row of short
// texts above it. On desktop each process link opens a focus panel over the blurred hero.
import { Image } from 'astro:assets';
import { hero } from '../../data/home';
import { caseImages } from '../figma/images';

const petals = Array.from({ length: 8 }, (_, i) => i * 45);
---

<section class="hero" data-hero>
  <div class="hero__mesh" aria-hidden="true">
    <i class="blob blob--bloom"></i>
    <i class="blob blob--left"></i>
    <i class="blob blob--right"></i>
    <i class="blob blob--core"></i>
  </div>
  <svg class="hero__grain" aria-hidden="true">
    <filter id="hero-grao">
      <feTurbulence type="fractalNoise" baseFrequency="0.85" numOctaves="2" stitchTiles="stitch" />
      <feColorMatrix type="saturate" values="0" />
    </filter>
    <rect width="100%" height="100%" filter="url(#hero-grao)" />
  </svg>

  <div class="container hero__inner">
    <svg class="hero__mark" viewBox="-50 -50 100 100" fill="currentColor" aria-hidden="true">
      {petals.map((a) => <ellipse cy="-28" rx="6.5" ry="22" transform={`rotate(${a})`} />)}
    </svg>

    <div class="hero__row">
      <p class="hero__role">{hero.role}</p>
      <p class="hero__intro">{hero.intro} <span class="hero__accent">{hero.introAccent}</span></p>
      <p class="hero__text"><i aria-hidden="true">↗</i>{hero.text}</p>
      <ul class="hero__points">
        {hero.points.map((p, i) => (
          <li><a href={p.href} class="point" data-point={i}>{p.label}</a></li>
        ))}
      </ul>
    </div>

    <div class="hero__base">
      <h1 class="headline"><span>{hero.titleA}</span> <span>{hero.titleB}</span></h1>
      <a href={hero.cta.href} class="hero__cta"><i aria-hidden="true"></i>{hero.cta.label}</a>
    </div>
  </div>

  <div class="hero__veil" aria-hidden="true"></div>
  {hero.points.map((p, i) => (
    <a href={p.href} class="focus" data-focus={i} tabindex="-1">
      <span class="focus__frame">
        <Image src={caseImages[p.image]} alt="" widths={[520, 1040]} sizes="520px" class="focus__img" />
      </span>
      <span class="focus__info">
        <span class="t-h2 focus__title">{p.title}</span>
        <span class="t-body-lg c-secondary">{p.text}</span>
        <span class="t-link">Ver {p.project} →</span>
      </span>
    </a>
  ))}
</section>

<script>
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  const mark = hero?.querySelector<SVGElement>('.hero__mark');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');

  // The flower turns with the scroll, as on the previous Home
  let frame = 0;
  const tick = () => { mark?.style.setProperty('--turn', `${window.scrollY * 0.1}deg`); frame = 0; };
  if (mark && !reduce.matches) {
    window.addEventListener('scroll', () => { if (!frame) frame = requestAnimationFrame(tick); }, { passive: true });
  }

  if (hero) {
    const points = hero.querySelectorAll<HTMLElement>('[data-point]');
    const panels = hero.querySelectorAll<HTMLElement>('[data-focus]');
    let timer = 0;
    const show = (i: number | null) => {
      clearTimeout(timer);
      hero.classList.toggle('is-focus', i !== null);
      panels.forEach((p, k) => p.classList.toggle('is-open', k === i));
      points.forEach((b, k) => b.classList.toggle('is-active', k === i));
    };
    const later = () => { timer = window.setTimeout(() => show(null), 220); };
    points.forEach((b, i) => {
      b.addEventListener('pointerenter', () => show(i));
      b.addEventListener('pointerleave', later);
      b.addEventListener('focus', () => show(i));
      b.addEventListener('blur', later);
    });
    panels.forEach((p) => {
      p.addEventListener('pointerenter', () => clearTimeout(timer));
      p.addEventListener('pointerleave', later);
    });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') show(null); });
  }
</script>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    background: var(--bg-default);
  }

  /* Gradient: soft radial blooms that drift slowly. The dark core draws the arch of light. */
  .hero__mesh {
    position: absolute;
    inset: 0;
    -webkit-mask-image: linear-gradient(#000 52%, transparent 92%);
    mask-image: linear-gradient(#000 52%, transparent 92%);
  }
  .blob {
    position: absolute;
    border-radius: 50%;
    will-change: transform;
    animation: blob 46s ease-in-out infinite alternate;
  }
  .blob--bloom {
    left: 4%;
    top: -34%;
    width: 62%;
    height: 96%;
    background: radial-gradient(closest-side, var(--hero-bloom), color-mix(in srgb, var(--hero-bloom) 56%, transparent) 46%, transparent);
  }
  .blob--left {
    left: -26%;
    top: -26%;
    width: 72%;
    height: 128%;
    background: radial-gradient(closest-side, var(--hero-left) 25%, color-mix(in srgb, var(--hero-left) 55%, transparent) 62%, transparent);
    animation-duration: 58s;
    animation-direction: alternate-reverse;
  }
  .blob--right {
    right: -24%;
    top: -30%;
    width: 84%;
    height: 112%;
    background: radial-gradient(closest-side, var(--hero-right) 20%, color-mix(in srgb, var(--hero-right) 55%, transparent) 60%, transparent);
    animation-duration: 64s;
  }
  .blob--core {
    left: 32%;
    top: 16%;
    width: 46%;
    height: 96%;
    background: radial-gradient(closest-side, var(--hero-core) 34%, color-mix(in srgb, var(--hero-core) 62%, transparent) 64%, transparent);
    animation-duration: 52s;
    animation-direction: alternate-reverse;
  }
  @keyframes blob {
    from { transform: translate3d(-3%, -2%, 0) scale(1); }
    to { transform: translate3d(4%, 3%, 0) scale(1.08); }
  }
  .hero__grain {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: var(--hero-grain);
    mix-blend-mode: soft-light;
    -webkit-mask-image: linear-gradient(#000 60%, transparent 92%);
    mask-image: linear-gradient(#000 60%, transparent 92%);
    pointer-events: none;
  }

  .hero__inner {
    position: relative;
    display: flex;
    flex-direction: column;
    width: 100%;
    flex: 1;
    padding-top: 96px;
    padding-bottom: var(--space-32);
  }
  .hero__mark {
    width: 64px;
    height: 64px;
    flex: none;
    margin-bottom: var(--space-24);
    color: var(--text-primary);
    rotate: var(--turn, 0deg);
    transition: rotate 600ms var(--ease-out);
  }

  .hero__row {
    display: grid;
    gap: var(--space-24);
    margin-top: auto;
    font-size: 16px;
    line-height: 1.35;
    color: var(--text-primary);
  }
  .hero__role {
    justify-self: start;
    padding: 7px 16px;
    border: var(--border-width) solid color-mix(in srgb, var(--text-primary) 55%, transparent);
    border-radius: 999px;
    white-space: nowrap;
  }
  .hero__intro { max-width: 15em; text-wrap: balance; }
  .hero__accent {
    font-family: var(--font-accent);
    font-style: italic;
    font-size: 1.2em;
    line-height: 1;
  }
  .hero__text {
    position: relative;
    max-width: 19em;
    text-wrap: balance;
    padding-left: 26px;
  }
  .hero__text i {
    position: absolute;
    left: 0;
    top: 0;
    font-style: normal;
  }
  .hero__points {
    display: flex;
    flex-wrap: wrap;
    gap: 6px var(--space-16);
  }
  .point {
    position: relative;
    display: inline-block;
    color: var(--text-primary);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
    transition: opacity 300ms var(--ease-out);
  }
  .is-focus .point:not(.is-active) { opacity: 0.45; }

  .hero__base {
    display: grid;
    gap: var(--space-24);
    margin-top: var(--space-40);
  }
  .headline {
    font-family: var(--font-heading);
    font-weight: 300;
    font-size: 18.4vw;
    line-height: 0.92;
    letter-spacing: -0.045em;
    text-transform: uppercase;
    white-space: nowrap;
    margin-left: -0.05em;
  }
  .headline > span { display: block; }
  .hero__cta {
    display: inline-flex;
    align-items: center;
    gap: var(--space-16);
    justify-self: start;
    font-size: 16px;
    color: var(--text-primary);
  }
  .hero__cta i {
    position: relative;
    width: 32px;
    height: 1px;
    background: currentColor;
    transition: width 300ms var(--ease-out);
  }
  .hero__cta i::after {
    content: "";
    position: absolute;
    right: 0;
    top: -3px;
    width: 7px;
    height: 7px;
    border-top: 1px solid;
    border-right: 1px solid;
    transform: rotate(45deg);
  }
  .hero__cta:hover i { width: 44px; }

  .hero__veil {
    position: absolute;
    inset: 0;
    z-index: 2;
    background: color-mix(in srgb, var(--bg-default) 42%, transparent);
    backdrop-filter: blur(22px);
    opacity: 0;
    pointer-events: none;
    transition: opacity 300ms var(--ease-out);
  }
  .is-focus .hero__veil { opacity: 1; }

  .focus {
    position: absolute;
    z-index: 3;
    left: var(--layout-margin);
    top: 50%;
    display: flex;
    align-items: center;
    gap: var(--space-40);
    width: calc(72% - var(--layout-margin));
    transform: translateY(-50%) scale(0.98);
    transform-origin: 0 50%;
    opacity: 0;
    visibility: hidden;
    transition: opacity 300ms var(--ease-out), transform 300ms var(--ease-out), visibility 300ms;
  }
  .focus.is-open {
    opacity: 1;
    visibility: visible;
    transform: translateY(-50%);
  }
  .focus__frame {
    position: relative;
    flex: 0 0 56%;
    aspect-ratio: 13 / 10;
    outline: 1px solid color-mix(in srgb, var(--text-primary) 65%, transparent);
    outline-offset: 6px;
  }
  .focus__img { width: 100%; height: 100%; object-fit: cover; }
  .focus__info {
    display: flex;
    flex-direction: column;
    gap: var(--space-16);
  }

  @media (min-width: 900px) {
    .hero { min-height: max(100vh, 720px); }
    .hero__inner { padding-top: 128px; padding-bottom: var(--space-40); }
    .hero__mark { width: 84px; height: 84px; }
    .hero__row, .hero__base {
      grid-template-columns: 14fr 31fr 25fr 20fr;
      column-gap: var(--space-32);
    }
    .hero__row { align-items: start; }
    .hero__points { display: block; position: relative; z-index: 4; }
    .hero__points li + li { margin-top: 4px; }
    .hero__base { align-items: end; margin-top: var(--space-48); }
    .headline { grid-column: 1 / 4; font-size: min(10.6vw, 19vh); }
    .hero__cta { grid-column: 4; margin-bottom: 0.9em; }
  }
  @media (max-width: 899px) {
    .focus, .hero__veil { display: none; }
    .blob--bloom { left: -20%; width: 120%; top: -22%; height: 70%; }
    .blob--left { left: -60%; width: 130%; }
    .blob--right { right: -60%; width: 130%; top: -8%; height: 80%; }
    .blob--core { left: 12%; width: 100%; top: 22%; height: 70%; }
  }
  @media (prefers-reduced-motion: reduce) {
    .blob { animation: none; }
  }
</style>
