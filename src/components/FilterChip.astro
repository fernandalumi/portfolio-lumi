---
// Figma: component "Filter chip" (State=Default / Hover / Active).
// Rendered as a radio input so it works with keyboard and screen readers.
interface Props {
  name: string;
  value: string;
  checked?: boolean;
}
const { name, value, checked = false } = Astro.props;
---

<label class="chip">
  <input type="radio" name={name} value={value} checked={checked} />
  <span class="chip__label t-link"><slot /></span>
</label>

<style>
  .chip {
    position: relative;
    display: inline-flex;
    cursor: pointer;
  }
  .chip input {
    position: absolute;
    opacity: 0;
    inset: 0;
    margin: 0;
    cursor: pointer;
  }
  .chip__label {
    display: inline-flex;
    align-items: center;
    min-height: 38px;
    padding: var(--space-8) var(--space-16);
    border: var(--border-width) solid var(--border-subtle);
    border-radius: var(--radius-full);
    color: var(--text-secondary);
    white-space: nowrap;
    transition: border-color 200ms var(--ease-out), color 200ms var(--ease-out);
  }
  .chip:hover .chip__label {
    border-color: var(--border-default);
    color: var(--text-hover);
  }
  .chip input:checked + .chip__label {
    border-color: var(--border-strong);
    color: var(--text-primary);
  }
  .chip input:focus-visible + .chip__label {
    outline: 2px solid var(--text-primary);
    outline-offset: 2px;
  }
</style>
