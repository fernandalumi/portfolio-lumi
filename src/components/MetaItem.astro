---
// Figma: component "Case meta item" (label + value)
interface Props {
  label: string;
  value: string;
}
const { label, value } = Astro.props;
---

<div class="meta-item">
  <dt class="t-label c-tertiary">{label}</dt>
  <dd class="t-body c-primary">{value}</dd>
</div>

<style>
  .meta-item {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }
  dd {
    margin: 0;
  }
</style>
