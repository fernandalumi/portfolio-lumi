H":222.22,"w":350,"h":222.22,"rad":8.536585807800293}]},{"k":1,"W":390,"H":916,"w":"F","h":"H","d":"V","p":[0,20,0,20],"ax":"ss","c":[{"k":1,"W":350,"H":183,"w":"F","h":"H","bd":[[0,0,1,0],"#e5e7eb"],"d":"V","g":16,"p":[0,0,32,0],"ax":"ss","c":[{"k":2,"w":"F","h":"H","s":"text/label","x":"Quem é a White Martins","c":"#6b6d76","fw":500},{"k":2,"w":"F","h":"H","s":"text/body-lg","x":"A White Martins, uma empresa Linde, é a maior empresa de gases industriais da América do Sul. No e-commerce, vende para empresas: arames, máquinas de solda, reguladores, oxicombustíveis, corte e plasma e acessórios.","c":"#5c5f66"}]},{"k":1,"W":350,"H":407,"w":"F","h":"H","bd":[[0,0,1,0],"#e5e7eb"],"d":"V","g":16,"p":[32,0,32,0],"ax":"ss","c":[{"k":2,"w":"F","h":"H","s":"text/label","x":"O desafio","c":"#6b6d76","fw":500},{"k":2,"w":"F","h":"H","s":"text/body-lg","x":"O desafio era modernizar a experiência de compra B2B, tornando a plataforma mais clara, atual e intuitiva, sem perder as particularidades de uma operação voltada a empresas.\n\nO cliente precisava permitir que usuários não logados consultassem produtos e preços livremente, mas restringir a compra apenas para clientes cadastrados via CNPJ. Isso exigia uma experiência capaz de diferenciar claramente os níveis de acesso e orientar o usuário ao longo da jornada, desde a descoberta dos produtos até o cadastro e a compra.","c":"#5c5f66"}]},{"k":1,"W":350,"H":326,"w":"F","h":"H","d":"V","g":16,"p":[32,0,0,0],"ax":"ss","c":[{"k":2,"w":"F","h":"H","s":"text/label","x":"Minha atuação","c":"#6b6d76","fw":500},{"k":2,"w":"F","h":"H","s":"text/body-lg","x":"Atuei na adaptação e customização da interface do e-commerce B2B, traduzindo a identidade e as necessidades do cliente para dentro da estrutura do template proprietário.\nFui responsável pelo design das principais telas e pela definição dos diferentes estados da experiência, desde a navegação deslogada e consulta de preços até o cadastro via CNPJ, análise e a jornada do usuário logado, garantindo consistência visual e clareza ao longo de todo o fluxo.","c":"#5c5f66"}]}]},{"k":1,"W":390,"H":3850.39,"w":"F","h":"H","d":"V","g":24,"p":[48,20,48,20],"ax":"ss","c":[{"k":1,"W":350,"H":193,"w":"F","h":"H","d":"V","g":16,"ax":"ss","c":[{"k":1,"W":350,"H":33,"w":"F","h":"H","d":"V","ax":"ss","c":[{"k":2,"w":"F","h":"H","s":"heading/h2","x":"Quatro estados, uma só loja","c":"#202224"}]},{"k":1,"W":350,"H":144,"w":"F","h":"H","d":"V","ax":"ss","c":[{"k":2,"w":"F","h":"H","s":"text/body-lg","x":"Em vez de esconder o catálogo atrás do login, a loja fica aberta para todos, e a interface muda conforme o estado de acesso de quem navega. Cada tela mostra só o próximo passo possível: entrar, se cadastrar, aguardar a aprovação ou comprar.","c":"#5c5f66"}]}]},{"k":1,"W":350,"H":1699,"w":"F","h":"H","rad":24,"bg":"#f2f2f5","clip":1,"d":"V","g":10,"p":[20,16,20,16],"ax":"cc","c":[{"k":2,"w":"F","h":"H","s":"text/label","x":"Empresa já cadastrada","c":"#6b6d76","fw":500,"al":"C"},{"k":1,"W":318,"H":153,"w":"F","h":"H","rad":16,"bg":"#ffffff","bd":[1,"#e5e7eb"],"clip":1,"d":"V","g":10,"p":[20,20,20,20],"ax":"ss","c":[{"k":1,"W":94,"H":22,"w":"H","h":"H","rad":999,"bg":"#e5e7eb","clip":1,"d":"H","p":[4,10,4,10],"ax":"ss","c":[{"k":2,"w":"H","h":"H","s":"text/label","x":"Deslogado","c":"#374151","fw":500,"nw":1}]},{"k":2,"w":"F","h":"H","s":"heading/h4","x":"Visitante","c":"#202224","fw":500},{"k":2,"w":"F","h":"H","s":"text/body","x":"Navega pelo catálogo com preço. O botão de compra leva ao login.","c":"#5c5f66"}]},{"k":2,"w":"H","h":"H","s":"text/body-lg","x":"↓","c":"#005d21","nw":1},{"k":1,"W":318,"H":176,"w":"F","h":"H","rad":16,"bg":"#ffffff","bd":[1,"#e5e7eb"],"clip":1,"d":"V","g":10,"p":[20,20,20,20],"ax":"ss","c":[{"k":1,"W":68,"H":22,"w":"H","h":"H","rad":999,"bg":"#e5e7eb","clip":1,"d":"H","p":[4,10,4,10],"ax":"ss","c":[{"k":2,"w":"H","h":"H","s":"text/label","x":"Acesso","c":"#374151","fw":500,"nw":1}]},{"k":2,"w":"F","h":"H","s":"heading/h4","x":"Login","c"