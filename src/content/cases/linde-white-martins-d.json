h":833,"rad":32}]},{"k":1,"W":1440,"H":762,"w":"F","h":"H","d":"V","p":[24,64,64,64],"ax":"ss","c":[{"k":1,"W":1312,"H":162,"w":"F","h":"H","bd":[[0,0,1,0],"#e5e7eb"],"d":"H","g":128,"p":[40,0,40,0],"ax":"ss","c":[{"k":2,"w":424,"h":"H","s":"text/label","x":"Quem é a White Martins","c":"#6b6d76","fw":500},{"k":2,"w":760,"h":"H","s":"text/body-lg","x":"A White Martins, uma empresa Linde, é a maior empresa de gases industriais da América do Sul. No e-commerce, vende para empresas: arames, máquinas de solda, reguladores, oxicombustíveis, corte e plasma e acessórios.","c":"#5c5f66"}]},{"k":1,"W":1312,"H":270,"w":"F","h":"H","bd":[[0,0,1,0],"#e5e7eb"],"d":"H","g":128,"p":[40,0,40,0],"ax":"ss","c":[{"k":2,"w":424,"h":"H","s":"text/label","x":"O desafio","c":"#6b6d76","fw":500},{"k":2,"w":760,"h":"H","s":"text/body-lg","x":"O desafio era modernizar a experiência de compra B2B, tornando a plataforma mais clara, atual e intuitiva, sem perder as particularidades de uma operação voltada a empresas.\n\nO cliente precisava permitir que usuários não logados consultassem produtos e preços livremente, mas restringir a compra apenas para clientes cadastrados via CNPJ. Isso exigia uma experiência capaz de diferenciar claramente os níveis de acesso e orientar o usuário ao longo da jornada, desde a descoberta dos produtos até o cadastro e a compra.","c":"#5c5f66"}]},{"k":1,"W":1312,"H":242,"w":"F","h":"H","d":"H","g":128,"p":[40,0,40,0],"ax":"ss","c":[{"k":2,"w":424,"h":"H","s":"text/label","x":"Minha atuação","c":"#6b6d76","fw":500},{"k":2,"w":760,"h":"H","s":"text/body-lg","x":"Atuei na adaptação e customização da interface do e-commerce B2B, traduzindo a identidade e as necessidades do cliente para dentro da estrutura do template proprietário.\nFui responsável pelo design das principais telas e pela definição dos diferentes estados da experiência, desde a navegação deslogada e consulta de preços até o cadastro via CNPJ, análise e a jornada do usuário logado, garantindo consistência visual e clareza ao longo de todo o fluxo.","c":"#5c5f66"}]}]},{"k":1,"W":1440,"H":1827,"w":"F","h":"H","d":"V","g":40,"p":[64,64,64,64],"ax":"ss","c":[{"k":1,"W":1312,"H":81,"w":"F","h":"H","d":"H","g":24,"ax":"ss","c":[{"k":1,"W":528,"H":47,"w":"F","h":"H","d":"V","ax":"ss","c":[{"k":2,"w":"H","h":"H","s":"heading/h2","x":"Quatro estados, uma só loja","c":"#202224","nw":1}]},{"k":1,"W":760,"H":81,"w":760,"h":"H","d":"V","ax":"ss","c":[{"k":2,"w":"F","h":"H","s":"text/body-lg","x":"Em vez de esconder o catálogo atrás do login, a loja fica aberta para todos, e a interface muda conforme o estado de acesso de quem navega. Cada tela mostra só o próximo passo possível: entrar, se cadastrar, aguardar a aprovação ou comprar.","c":"#5c5f66"}]}]},{"k":3,"key":"linde-white-martins-d-002","alt":"","W":1312,"H":744,"w":"F","h":744,"rad":32},{"k":1,"W":1312,"H":94,"w":"F","h":"H","d":"H","g":24,"p":[40,0,0,0],"ax":"ss","c":[{"k":1,"W":528,"H":29,"w":"F","h":"H","d":"V","ax":"ss","c":[{"k":2,"w":"H","h":"H","s":"heading/h3","x":"O mesmo card, três estados","c":"#202224","fw":500,"nw":1}]},{"k":1,"W":760,"H":54,"w":760,"h":"H","d":"V","ax":"ss","c":[{"k":2,"w":"F","h":"H","s":"text/body-lg","x":"O produto e o preço nunca somem. O que muda é a ação: ela sempre diz em que ponto da jornada a empresa está.","c":"#5c5f66"}]}]},{"k":1,"W":1312,"H":660,"w":"F","h":"H","d":"H","g":24,"ax":"ss","c":[{"k":1,"W":421.33,"H":660,"w":"F","h":"H","d":"V","g":16,"ax":"ss","c":[{"k":3,"key":"linde-white-martins-d-003","alt":"","W":421,"H":560,"w":421,"h":560,"rad":24},{"k":1,"W":94,"H":22,"w":"H","h":"H","rad":999,"bg":"#e5e7eb","clip":1,"d":"H","p":[4,10,4,10],"ax":"ss","c":[{"k":2,"w":"H","h":"H","s":"text/label","x":"Deslogado","c":"#374151","fw":500,"nw":1}]},{"k":2,"w":"F","h":"H","s":"text/body","x":"Vê produto e preço. “Faça login para comprar” leva direto \nao login.","c":"#5c5f66"}]},{"k":1,"W":421.33,"H":660,"w":"F","h":"H","d":"V","g":16,"ax":"ss","c":[{"k":3,"key":"linde-white-martins