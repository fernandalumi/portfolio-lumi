d":"V","p":[24,64,64,64],"ax":"ss","c":[{"k":1,"W":1312,"H":135,"w":"F","h":"H","bd":[[0,0,1,0],"#e5e7eb"],"d":"H","g":128,"p":[40,0,40,0],"ax":"ss","c":[{"k":2,"w":424,"h":"H","s":"text/label","x":"O cliente","c":"#6b6d76","fw":500},{"k":2,"w":760,"h":"H","sg":[{"x":"A Balaroti é ","c":"#5c5f66","ff":"Inter","fs":18,"lh":1.5,"ls":"-0.02em"},{"x":"uma das tradicionais redes brasileiras d","c":"#5c5f66","ff":"Inter","fs":18,"lh":1.5,"ls":"-0.02em"},{"x":"e materiais de construção","c":"#5c5f66","ff":"Inter","fs":18,"lh":1.5,"ls":"-0.02em"},{"x":", acabamento e decoração. Atende diferentes etapas de construção e reforma.","c":"#5c5f66","ff":"Inter","fs":18,"lh":1.5,"ls":"-0.02em"}]}]},{"k":1,"W":1312,"H":324,"w":"F","h":"H","bd":[[0,0,1,0],"#e5e7eb"],"d":"H","g":128,"p":[40,0,40,0],"ax":"ss","c":[{"k":2,"w":424,"h":"H","s":"text/label","x":"O problema","c":"#6b6d76","fw":500},{"k":2,"w":760,"h":"H","s":"text/body-lg","x":"O desafio era permitir que o cliente montasse seu kit diretamente na página de produto, escolhendo cada item e acompanhando o valor total da compra em tempo real, sem precisar navegar entre diferentes páginas ou etapas.\n\nA solução precisava tornar essa experiência simples e intuitiva, reduzindo fricções durante a montagem do kit e dando mais clareza sobre as escolhas e o valor final. Ao centralizar toda a jornada em uma única página, o objetivo era facilitar a tomada de decisão e criar uma experiência mais fluida, com potencial para aumentar a quantidade de itens adicionados ao carrinho e, consequentemente, o valor da compra.","c":"#5c5f66"}]},{"k":1,"W":1312,"H":242,"w":"F","h":"H","d":"H","g":128,"p":[40,0,40,0],"ax":"ss","c":[{"k":2,"w":424,"h":"H","s":"text/label","x":"MINHA ATUAÇÃO","c":"#6b6d76","fw":500},{"k":2,"w":760,"h":"H","s":"text/body-lg","x":"Atuei na estruturação e no design da experiência de montagem do kit, transformando a necessidade de negócio em uma interface clara e funcional.\n\nFui responsável por definir a organização dos elementos na página, os estados de seleção dos produtos, a atualização do valor total e os principais pontos de interação da jornada, buscando equilibrar facilidade de uso e clareza das informações.","c":"#5c5f66"}]}]},{"k":1,"W":1440,"H":918.47,"w":"F","h":"H","d":"V","g":40,"p":[64,64,64,64],"ax":"ss","c":[{"k":1,"W":1312,"H":81,"w":"F","h":"H","d":"H","g":24,"ax":"ss","c":[{"k":1,"W":528,"H":47,"w":"F","h":"H","d":"V","ax":"ss","c":[{"k":2,"w":"H","h":"H","s":"heading/h2","x":"Estrutura do Kit completo","c":"#202224","nw":1}]},{"k":1,"W":760,"H":81,"w":760,"h":"H","d":"V","ax":"ss","c":[{"k":2,"w":"F","h":"H","s":"text/body-lg","x":"A página já tinha três zonas: a imagem, as informações do produto e a área de compra. O kit entrou na coluna do meio, logo abaixo da descrição: é onde o cliente está decidindo, e fica na mesma altura do preço e do botão de comprar, que mostram o efeito de cada escolha.","c":"#5c5f66"}]}]},{"k":3,"key":"balaroti-d-002","alt":"","W":1312,"H":669.47,"w":"F","h":669.47,"rad":32}]},{"k":1,"W":1440,"H":3335.46,"w":"F","h":"H","d":"V","p":[32,16,32,16],"ax":"ss","c":[{"k":1,"W":1408,"H":3271.46,"w":"F","h":"H","rad":32,"bg":"#0a0a0a","clip":1,"d":"V","g":120,"p":[120,48,120,48],"ax":"ss","c":[{"k":1,"W":1312,"H":73,"w":"F","h":"H","d":"H","g":32,"ax":"bs","c":[{"k":2,"w":"H","h":"H","s":"heading/display","x":"O componente","c":"#fafafa","nw":1},{"k":2,"w":760,"h":"H","s":"text/body-lg","x":"Cada detalhe responde a uma dúvida que o cliente teria na hora de montar o kit: o que já está incluído, quanto custa cada item e quanto vou pagar no total.","c":"#a3a3a3"}]},{"k":1,"W":1312,"H":914,"w":"F","h":"H","d":"V","g":40,"ax":"ss","c":[{"k":1,"W":1312,"H":54,"w":"F","h":"H","d":"H","g":24,"ax":"ss","c":[{"k":1,"W":528,"H":47,"w":"F","h":"H","d":"V","ax":"ss","c":[{"k":2,"w":"H","h":"H","s":"heading/h2","x":"Anatomia","c":"#fafafa","nw":1}]},{"k":1,"W":760,"H":54,"w":760,"h":"H","d":"V","ax":"ss","c":[{"k":2,"w":"F","h":"H","s":"text/body-lg","x":"O componente usa as peças que a página já tinha (checkbox, selo de desconto, preço de e por) em uma lista compacta. Nada de novo para o cliente aprender.","c":"#a3a3a3"}]}]},{"k":3,"key":"balaroti-d-003","alt":"","W":1312,"H":820,"w":"F","h":820,"rad":24}]},{"k":1,"W":1312,"H":860.6,"w":"F","h":"H","d":"V","g":40,"ax":"ss","c":[{"k":1,"W":1312,"H":54,"w":"F","h":"H","d":"H","g":24,"ax":"ss","c":[{"k":1,"W":528,"H":47,"w":"F","h":"H","d":"V","ax":"ss","c":[{"k":2,"w":"H","h":"H","s":"heading/h2","x":"Como o total responde","c":"#fafafa","nw":1}]},{"k":1,"W":760,"H":54,"w":760,"h":"H","d":"V","ax":"ss","c":[{"k":2,"w":"F","h":"H","s":"text/body-lg","x":"Marcar ou desmarcar um item atualiza o preço da área de compra na hora, sem botão de aplicar. O cliente vê o custo do kit enquanto monta, e não só no carrinho.","c":"#a3a3a3"}]}]},{"k":1,"W":1312,"H":766.6,"w":"F","h":"H","d":"H","g":24,"ax":"ss","c":[{"k":1,"W":644,"H":766.6,"w":"F","h":"F","rad":24,"bg":"#262626","clip":1,"d":"V","g":20,"p":[40,40,40,40],"ax":"ss","c":[{"k":1,"W":115,"H":26,"w":"H","h":"H","rad":999,"bg":"rgba(245,130,32,0.15)","clip":1,"d":"H","p":[6,12,6,12],"ax":"ss","c":[{"k":2,"w":"H","h":"H","s":"text/label","x":"2 itens no kit","c":"#f58220","fw":500,"nw":1}]},{"k":1,"W":564,"H":574.6,"w":"F","h":"H","rad":16,"bg":"#f3f4f6","clip":1,"d":"V","g":16,"p":[24,24,24,24],"ax":"sc","c":[{"k":3,"key":"balaroti-d-004","alt":"kit com 2 itens","W":360,"H":367.42,"w":360,"h":367.42,"rad":10},{"k":2,"w":"H","h":"H","s":"heading/h3","x":"↓","c":"#6b7280","fw":500,"nw":1},{"k":3,"key":"balaroti-d-005","alt":"área de compra, total","W":360,"H":98.18,"w":360,"h":98.18,"rad":10}]},{"k":2,"w":"F","h":"H","s":"text/body","x":"Arandela R$ 153,90 + lâmpada Espiga R$ 27,90 = R$ 181,80","c":"#fafafa"}]},{"k":1,"W":644,"H":766.6,"w":"F","h":"F","rad":24,"bg":"#262626","clip":1,"d":"V","g":20,"p":[40,40,40,40],"ax":"ss","c":[{"k":1,"W":115,"H":26,"w":"H","h":"H","rad":999,"bg":"rgba(245,130,32,0.15)","clip":1,"d":"H","p